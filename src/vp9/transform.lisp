;;;; vp9/transform.lisp — GENERATED (the one-dimensional transforms) plus their wrapper.
;;;;
;;;; VP9 has TWO transforms and uses both in the same block.  The DCT is what every codec has; the
;;;; ADST — an asymmetric discrete sine transform — is used along whichever axis an intra prediction
;;;; ran, because the residual left by a directional prediction is small at the predicted edge and
;;;; large away from it, and a sine basis fits that shape where a cosine basis does not.  So a block
;;;; predicted vertically gets ADST down its columns and DCT across its rows, and the mode chooses
;;;; the pair.
;;;;
;;;; The one-dimensional passes below are transcribed MECHANICALLY from ffmpeg by parsing its C,
;;;; because they are six hundred lines of straight-line arithmetic in which every constant and
;;;; every shift is normative and one transposed digit gives a decoder that is wrong on one
;;;; coefficient in a thousand.
;;;;
;;;; The constants are cosines at fourteen fractional bits: 11585 is 2^14/sqrt(2), 15137 and 6270 are
;;;; 2^14*cos(pi/8) and 2^14*sin(pi/8), and so on down the butterfly.  Every product is rounded by
;;;; adding 2^13 before the shift, which is what makes the transform exactly specified rather than
;;;; approximately so.

(in-package #:reel.vp9)

(defun %idct4-1d (in base stride out obase)
  (declare (type coefs in out)
           (type (unsigned-byte 16) base obase) (type (integer 1 32) stride)
           (optimize (speed 3) (safety 0)))
  (let ((t0 0) (t1 0) (t2 0) (t3 0))
    (declare (type (signed-byte 32) t0 t1 t2 t3))
    (setf t0 (ash (+ (* (+ (aref in (+ base (* 0 stride))) (aref in (+ base (* 2 stride)))) 11585) (ash 1 13)) (- 14)))
    (setf t1 (ash (+ (* (- (aref in (+ base (* 0 stride))) (aref in (+ base (* 2 stride)))) 11585) (ash 1 13)) (- 14)))
    (setf t2 (ash (+ (- (* (aref in (+ base (* 1 stride))) 6270) (* (aref in (+ base (* 3 stride))) 15137)) (ash 1 13)) (- 14)))
    (setf t3 (ash (+ (+ (* (aref in (+ base (* 1 stride))) 15137) (* (aref in (+ base (* 3 stride))) 6270)) (ash 1 13)) (- 14)))
    (setf (aref out (+ obase 0)) (+ t0 t3))
    (setf (aref out (+ obase 1)) (+ t1 t2))
    (setf (aref out (+ obase 2)) (- t1 t2))
    (setf (aref out (+ obase 3)) (- t0 t3))
    (values)))

