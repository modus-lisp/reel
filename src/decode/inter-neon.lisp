;;;; decode/inter-neon.lisp — the six-tap motion-compensation filter on integer
;;;; NEON lanes (Modus SIMD layer 2b).  Loaded AFTER inter.lisp, so on Modus
;;;; last-definition-wins replaces the scalar mc-filter; on any other host the
;;;; #+modus guard leaves the scalar one in place.  Bit-exact with the scalar
;;;; kernel: eight output samples per step, each of the six taps a widening
;;;; multiply into 32-bit lanes (the sum reaches 255*160 = 40800, past s16, so
;;;; the accumulation is s32 in a low and a high half), then (+ 64) >> 7 in s32,
;;;; narrow to s16, saturate to u8.  A 4-wide block stores 4 bytes so a TMP row
;;;; is never overrun; the loads read up to 5 bytes past the block, which the
;;;; bordered planes and the (h+5)*w TMP raster absorb.  The taps are the same
;;;; fixnums the scalar arm uses, broadcast by %vi-dup32.
(in-package #:reel.decode)

#+modus
(defun mc-filter (ref rstride rbase w h fx fy filters dst dstride dbase tmp)
  (declare (type u8vec ref dst tmp) (type (simple-array (signed-byte 32) (8 6)) filters)
           (type dim rstride rbase dstride dbase) (type (integer 0 64) w h)
           (type (integer 0 7) fx fy)
           (optimize (speed 3) (safety 0)))
  (macrolet ((six (src p s1 s2 s3 f0 f1 f2 f3 f4 f5)
               (let ((lo (lambda (k f)
                           `(%vi-mul32 (%vi-sxtl (%vi-uxtl (%vi-ld8 ,src ,k))) (%vi-dup32 ,f))))
                     (hi (lambda (k f)
                           `(%vi-mul32 (%vi-sxtl2 (%vi-uxtl (%vi-ld8 ,src ,k))) (%vi-dup32 ,f)))))
                 (let ((ks `((- ,p ,s2) (- ,p ,s1) ,p (+ ,p ,s1) (+ ,p ,s2) (+ ,p ,s3)))
                       (fs (list f0 f1 f2 f3 f4 f5)))
                   (flet ((acc (fn)
                            (let ((e (funcall fn (first ks) (first fs))))
                              (loop for k in (rest ks) for f in (rest fs)
                                    do (setq e `(%vi-add32 ,e ,(funcall fn k f))))
                              `(%vi-sshr32 (%vi-add32 ,e (%vi-dup32 64)) 7))))
                     `(%vi-sqxtun (%vi-sqxtn2 (%vi-sqxtn ,(acc lo)) ,(acc hi))))))))
    (cond
      ((and (zerop fx) (zerop fy))
       (dotimes (r h)
         (let ((s (+ rbase (* r rstride))) (o (+ dbase (* r dstride))))
           (declare (type fixnum s o))
           (dotimes (c w) (setf (aref dst (+ o c)) (aref ref (+ s c)))))))
      ((zerop fy)
       (let ((f0 (aref filters fx 0)) (f1 (aref filters fx 1)) (f2 (aref filters fx 2))
             (f3 (aref filters fx 3)) (f4 (aref filters fx 4)) (f5 (aref filters fx 5)))
         (declare (type (signed-byte 16) f0 f1 f2 f3 f4 f5))
         (dotimes (r h)
           (let ((s (+ rbase (* r rstride))) (o (+ dbase (* r dstride))))
             (declare (type fixnum s o))
             (if (= w 4)
                 (%vi-st4 dst o (six ref s 1 2 3 f0 f1 f2 f3 f4 f5))
                 (dotimes (g (ash w -3))
                   (let ((p (+ s (* g 8))) (q (+ o (* g 8))))
                     (declare (type fixnum p q))
                     (%vi-st8 dst q (six ref p 1 2 3 f0 f1 f2 f3 f4 f5)))))))))
      ((zerop fx)
       (let ((f0 (aref filters fy 0)) (f1 (aref filters fy 1)) (f2 (aref filters fy 2))
             (f3 (aref filters fy 3)) (f4 (aref filters fy 4)) (f5 (aref filters fy 5))
             (s2 (* 2 rstride)) (s3 (* 3 rstride)))
         (declare (type (signed-byte 16) f0 f1 f2 f3 f4 f5) (type dim s2 s3))
         (dotimes (r h)
           (let ((s (+ rbase (* r rstride))) (o (+ dbase (* r dstride))))
             (declare (type fixnum s o))
             (if (= w 4)
                 (%vi-st4 dst o (six ref s rstride s2 s3 f0 f1 f2 f3 f4 f5))
                 (dotimes (g (ash w -3))
                   (let ((p (+ s (* g 8))) (q (+ o (* g 8))))
                     (declare (type fixnum p q))
                     (%vi-st8 dst q (six ref p rstride s2 s3 f0 f1 f2 f3 f4 f5)))))))))
      (t
       (let ((h0 (aref filters fx 0)) (h1 (aref filters fx 1)) (h2 (aref filters fx 2))
             (h3 (aref filters fx 3)) (h4 (aref filters fx 4)) (h5 (aref filters fx 5))
             (v0 (aref filters fy 0)) (v1 (aref filters fy 1)) (v2 (aref filters fy 2))
             (v3 (aref filters fy 3)) (v4 (aref filters fy 4)) (v5 (aref filters fy 5)))
         (declare (type (signed-byte 16) h0 h1 h2 h3 h4 h5 v0 v1 v2 v3 v4 v5))
         (dotimes (r (+ h 5))
           (let ((s (+ rbase (* (- r 2) rstride))) (o (* r w)))
             (declare (type fixnum s o))
             (if (= w 4)
                 (%vi-st4 tmp o (six ref s 1 2 3 h0 h1 h2 h3 h4 h5))
                 (dotimes (g (ash w -3))
                   (let ((p (+ s (* g 8))) (q (+ o (* g 8))))
                     (declare (type fixnum p q))
                     (%vi-st8 tmp q (six ref p 1 2 3 h0 h1 h2 h3 h4 h5)))))))
         (let ((w2 (* 2 w)) (w3 (* 3 w)))
           (declare (type fixnum w2 w3))
           (dotimes (r h)
             (let ((k0 (* (+ r 2) w)) (o (+ dbase (* r dstride))))
               (declare (type fixnum k0 o))
               (if (= w 4)
                   (%vi-st4 dst o (six tmp k0 w w2 w3 v0 v1 v2 v3 v4 v5))
                   (dotimes (g (ash w -3))
                     (let ((k (+ k0 (* g 8))) (q (+ o (* g 8))))
                       (declare (type fixnum k q))
                       (%vi-st8 dst q (six tmp k w w2 w3 v0 v1 v2 v3 v4 v5))))))))))))
  (values))
