(defun %iwht4-1d (in base stride out obase pass)
  "The Walsh-Hadamard a LOSSLESS frame uses instead of the DCT.

   It is exact — integer in, integer out, invertible — which the DCT is not, and that is the whole
   reason it is here: a lossless frame cannot afford a transform that rounds.  The first pass shifts
   its input down by two because the encoder shifted up by two, and the second does not."
  (declare (type coefs in out)
           (type (unsigned-byte 16) base obase) (type (integer 1 32) stride)
           (optimize (speed 3) (safety 0)))
  (macrolet ((in (k) `(aref in (+ base (* ,k stride)))))
    (let ((t0 0) (t1 0) (t2 0) (t3 0) (t4 0))
      (declare (type (signed-byte 32) t0 t1 t2 t3 t4))
      (if (zerop pass)
          (setf t0 (ash (in 0) -2) t1 (ash (in 3) -2)
                t2 (ash (in 1) -2) t3 (ash (in 2) -2))
          (setf t0 (in 0) t1 (in 3) t2 (in 1) t3 (in 2)))
      (incf t0 t2)
      (decf t3 t1)
      (setf t4 (ash (- t0 t3) -1))
      (setf t1 (- t4 t1))
      (setf t2 (- t4 t2))
      (decf t0 t1)
      (incf t3 t2)
      (setf (aref out (+ obase 0)) t0 (aref out (+ obase 1)) t1
            (aref out (+ obase 2)) t2 (aref out (+ obase 3)) t3)
      (values))))

;;; ---- the two passes, and adding the result to the prediction --------------------------------------
;;;
;;; A transform is one pass down the columns and one across the rows, and the SHIFT between them is
;;; not the same for every size: four bits at 4x4, five at 8x8, six at 16x16 and 32x32, and none at
;;; all for the lossless Walsh-Hadamard.  The shift is what keeps the intermediate values inside a
;;; thirty-two bit range, so it belongs to the size and not to the transform.

(defparameter +itxfm-bits+
  (make-array 5 :element-type '(signed-byte 32) :initial-contents '(4 5 6 6 0))
  "The final right shift, by transform size, with the lossless Walsh-Hadamard last.")
(declaim (type (simple-array (signed-byte 32) (5)) +itxfm-bits+))

(declaim (inline %clip8))
(defun %clip8 (v) (declare (type fixnum v) (optimize (speed 3) (safety 0)))
  (if (< v 0) 0 (if (> v 255) 255 v)))

(defun %itxfm-add (dst stride base coeffs sz tx txtp eob lossless cbase)
  "Transform the SZ x SZ block in COEFFS and add it to the samples at BASE.

   THE DC-ONLY SHORTCUT IS NOT AN OPTIMISATION.  A block whose only coefficient is its first takes a
   different arithmetic path — one multiply, twice — and it agrees with the full transform to within
   nothing at all, so which path a block takes is part of the format.  It applies only to the plain
   DCT: a block with an ADST along either axis always takes the long way, because the ADST's first
   basis function is not constant."
  (declare (type octets dst) (type coefs coeffs)
           (type fixnum stride base sz tx txtp eob cbase)
           (optimize (speed 3) (safety 1)))
  (let ((bits (aref +itxfm-bits+ (if lossless 4 tx)))
        (tmp (make-array (* sz sz) :element-type '(signed-byte 32)))
        (out (make-array sz :element-type '(signed-byte 32))))
    (declare (type (integer 0 6) bits) (dynamic-extent tmp out))
    (when (and (not lossless) (= txtp 0) (= eob 1))
      (let ((v (ash (+ (* (ash (+ (* (aref coeffs cbase) 11585) 8192) -14) 11585) 8192) -14)))
        (declare (type fixnum v))
        (setf (aref coeffs cbase) 0)
        (let ((r (if (plusp bits) (ash (+ v (ash 1 (1- bits))) (- bits)) v)))
          (declare (type fixnum r))
          (dotimes (i sz)
            (dotimes (j sz)
              (let ((k (+ base (* j stride) i)))
                (setf (aref dst k) (%clip8 (+ (aref dst k) r)))))))
        (return-from %itxfm-add)))
    ;; THE FIRST PASS IS THE COLUMNS AND THE SECOND IS THE ROWS, and which of them gets the ADST is
    ;; the low bit and the high bit of the transform type respectively — not the other way round.
    ;; Swapping them decodes a picture that looks almost right, because the two transforms agree on
    ;; flat content and differ only where the prediction had a direction.
    (let ((fa (if lossless :wht (%1d-for tx (logand txtp 1))))
          (fb (if lossless :wht (%1d-for tx (ash txtp -1)))))
        ;; the first pass runs down each column and lays the result out in rows
        (dotimes (i sz) (%run-1d fa coeffs (+ cbase i) sz tmp (* i sz) 0))
        (fill coeffs 0 :start cbase :end (+ cbase (* sz sz)))
        (dotimes (i sz)
          (%run-1d fb tmp i sz out 0 1)
          (dotimes (j sz)
            (let ((k (+ base (* j stride) i))
                  (v (if (plusp bits)
                         (ash (+ (aref out j) (ash 1 (1- bits))) (- bits))
                         (aref out j))))
              (declare (type fixnum v))
              (setf (aref dst k) (%clip8 (+ (aref dst k) v)))))))
    (values)))

(declaim (inline %1d-for))
(defun %1d-for (tx adst)
  "Which one-dimensional pass a transform size and an axis want."
  (declare (type fixnum tx adst))
  (if (plusp adst)
      (case tx (0 :adst4) (1 :adst8) (2 :adst16) (t :dct32))
      (case tx (0 :dct4) (1 :dct8) (2 :dct16) (t :dct32))))

(defun %run-1d (which in base stride out obase pass)
  (declare (type coefs in out) (type (unsigned-byte 16) base obase)
           (type (integer 1 32) stride) (type fixnum pass))
  (ecase which
    (:dct4 (%idct4-1d in base stride out obase))
    (:adst4 (%iadst4-1d in base stride out obase))
    (:dct8 (%idct8-1d in base stride out obase))
    (:adst8 (%iadst8-1d in base stride out obase))
    (:dct16 (%idct16-1d in base stride out obase))
    (:adst16 (%iadst16-1d in base stride out obase))
    (:dct32 (%idct32-1d in base stride out obase))
    (:wht (%iwht4-1d in base stride out obase pass))))
