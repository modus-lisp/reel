;;; ---- which transform a mode implies ---------------------------------------------------------------
;;;
;;; An intra mode says which way the prediction runs, and the residual left over runs the other way,
;;; so the transform follows the mode: a vertical prediction gets ADST down the columns and DCT
;;; across, a horizontal one the reverse, and the diagonals get ADST both ways.  Inter blocks always
;;; get DCT both ways, because there is no direction to infer.

(defparameter +intra-txfm-type+
  (make-array 14 :element-type '(unsigned-byte 8) :initial-contents
   '(2 1 0 0 3 2 1 2 1 3 0 0 0 0))
  "Mode to transform type: 0 DCT/DCT, 1 DCT/ADST, 2 ADST/DCT, 3 ADST/ADST.  The last four entries
   are the inter modes, which share the array and are always plain.")

(declaim (type simple-vector +scans+ +scans-nb+))
(declaim (type (simple-array (unsigned-byte 8) (14)) +intra-txfm-type+))
